flowchart TB
    start(("Start")) --> script["run_pipeline.sh"]
    script --> orchestrator["main.py"]
    orchestrator --> agents{"Select Agents"}
    
    agents -->|Biological| bio["BiologicalAgent"]
    agents -->|Technical| tech["TechnicalAgent"]
    agents -->|Experimental| exp["ExperimentalDesignAgent"]
    
    subgraph Core_Extraction ["Extraction & Validation Loop"]
        direction TB
        read["Read Input .txt"] --> prompt["Generate Domain Prompt"]
        prompt --> llm1["LLM Extraction Pass"]
        llm1 --> raw["Initial JSON"]
        
        raw --> validator{"Validation Enabled?"}
        validator -- Yes --> critic["ValidationAgent (The Critic)"]
        critic --> llm2["LLM Verification Pass"]
        llm2 --> clean["Validated JSON"]
        validator -- No --> clean
        
        clean --> save["Save to .json"]
    end
    
    bio & tech & exp --> Core_Extraction
    save --> output["Output Directory"]
